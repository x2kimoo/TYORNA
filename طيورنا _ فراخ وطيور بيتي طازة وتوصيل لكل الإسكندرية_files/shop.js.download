// Explain: Shop page behaviors: category filtering, product display, and add to cart functionality.
/* Shop: category filtering + add to cart */
document.addEventListener('DOMContentLoaded', function () {
    var grid = document.getElementById('product-grid');
    var catButtons = Array.prototype.slice.call(document.querySelectorAll('.cat-btn'));
    var emptyEl = document.getElementById('no-products');

    var CAT_MAP = {
        whole: 'فراخ كاملة طازجة',
        breast: 'صدور وفيليه',
        thigh: 'أوراك وأجنحة',
        marinated: 'فراخ متبلة جاهزة',
        baniah: 'بانيه وشيش',
        giblets: 'كبد وقوانص',
        other: 'دواجن أخرى'
    };

    function applyFilter(filter) {
        if (grid) {
            var cards = grid.querySelectorAll('[data-product]');
            var visible = 0;
            Array.prototype.forEach.call(cards, function (card) {
                var cat = card.getAttribute('data-category') || '';
                if (filter === 'all' || cat === filter) {
                    card.classList.remove('is-filtered-out');
                    visible += 1;
                } else {
                    card.classList.add('is-filtered-out');
                }
            });
            if (emptyEl) {
                if (visible === 0) { emptyEl.classList.remove('hidden'); }
                else { emptyEl.classList.add('hidden'); }
            }
        }
        catButtons.forEach(function (btn) {
            if (btn.getAttribute('data-filter') === filter) { btn.classList.add('is-active'); }
            else { btn.classList.remove('is-active'); }
        });
    }

    catButtons.forEach(function (btn) {
        btn.addEventListener('click', function () {
            applyFilter(btn.getAttribute('data-filter') || 'all');
        });
    });

    if (grid) {
        var initial = 'all';
        try {
            var params = new URLSearchParams(window.location.search);
            var slug = params.get('app_cat');
            if (slug && CAT_MAP[slug]) { initial = CAT_MAP[slug]; }
        } catch (err) {}
        applyFilter(initial);
    }

    // Add to cart (works on shop cards + featured cards)
    document.addEventListener('click', function (e) {
        var btn = e.target.closest('.add-to-cart-btn');
        if (!btn) { return; }
        e.preventDefault();
        var uid = btn.getAttribute('data-uid');
        if (!uid) { return; }

        var weight = 1;
        var card = btn.closest('[data-product]');
        if (card) {
            var wsel = card.querySelector('.weight-select');
            if (wsel) { weight = parseInt(wsel.value, 10) || 1; }
            var csel = card.querySelector('.cut-select');
            if (csel) {
                try { window.localStorage.setItem('app_cut_' + uid, csel.value); } catch (err2) {}
            }
        }

        var original = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i> جاري الإضافة...';

        window.OrderSystem.addToCart({ unique_id_txt: uid }, weight).then(function (res) {
            btn.disabled = false;
            if (res && res.success) {
                btn.innerHTML = '<i class="fa-solid fa-check me-2"></i> تمت الإضافة';
                if (typeof window.updateCartBadge === 'function') { window.updateCartBadge(); }
                if (typeof window.showToast === 'function') { window.showToast('تمت إضافة المنتج إلى السلة'); }
                window.setTimeout(function () { btn.innerHTML = original; }, 1600);
            } else {
                btn.innerHTML = original;
                var emsg = (res && res.error) ? res.error : 'تعذر إضافة المنتج، حاول مرة أخرى.';
                if (typeof window.showToast === 'function') { window.showToast(emsg, true); }
            }
        }).catch(function () {
            btn.disabled = false;
            btn.innerHTML = original;
            if (typeof window.showToast === 'function') { window.showToast('حدث خطأ في الشبكة، حاول لاحقاً.', true); }
        });
    });
});